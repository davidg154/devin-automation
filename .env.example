# Devin API key — https://app.devin.ai/settings/api
DEVIN_API_KEY=your_devin_api_key_here

# GitHub personal access token (needs repo + issues scopes)
GITHUB_TOKEN=ghp_your_token_here

# Your Superset fork, e.g. "your-username/superset"
GITHUB_REPO=your-username/superset

# Secret used to verify GitHub webhook signatures (set the same value in the webhook settings)
WEBHOOK_SECRET=your_webhook_secret_here

# Label that triggers Devin (must match the label used in your GitHub repo)
DEVIN_TRIGGER_LABEL=devin-fix

# How often (seconds) to poll Devin for session status updates
POLL_INTERVAL_SECONDS=30

# Path to the SQLite database file (relative to /app inside the container)
DATABASE_PATH=data/sessions.db
